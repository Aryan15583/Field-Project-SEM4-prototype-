# ---- Copy to .env and fill in. NEVER commit .env ----

# Public domain (Caddy gets an HTTPS certificate for it automatically)
DOMAIN=codeingo.example.com

# Generate:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: https://<DOMAIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only allow these email domains, e.g. ["myschool.edu"]
ALLOWED_EMAIL_DOMAINS=[]
# Accounts that get the admin role on sign-in
ADMIN_EMAILS=["you@gmail.com"]

# Email for sign-in codes (REQUIRED in production). Any SMTP provider works:
#  - Gmail: smtp.gmail.com, port 587, your address + an App Password
#    (Google Account -> Security -> 2-Step Verification -> App passwords). Fine for small sites.
#  - For real traffic use a transactional service (Amazon SES, Postmark, Mailgun, SendGrid, Brevo...)
#    and set up SPF/DKIM for your domain so codes don't land in spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls        # starttls (port 587) or ssl (port 465)
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Codeingo <no-reply@codeingo.example.com>

# Optional AI tutor - any OpenAI-compatible API (OpenAI, Mistral, Llama 3 via Ollama/vLLM/Groq...)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=

# Optional sandbox for Java/C/C++ exercises (docker compose --profile runner). Leave empty to use pattern checks.
CODE_RUNNER_URL=

# ---- Local development only (backend/.env) ----
# ENV=development
# DEV_LOGIN_ENABLED=true
# COOKIE_SECURE=true
# PUBLIC_URL=http://localhost:3000
