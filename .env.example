# ---- Copy to .env and fill in. NEVER commit .env ----

# Public domain (Caddy gets an HTTPS certificate for it automatically)
DOMAIN=codeingo.example.com

# Generate:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: https://<DOMAIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only allow these email domains, e.g. ["myschool.edu"]
ALLOWED_EMAIL_DOMAINS=[]
# Accounts that get the admin role on sign-in
ADMIN_EMAILS=["you@gmail.com"]

# Optional AI tutor - any OpenAI-compatible API (OpenAI, Mistral, Llama 3 via Ollama/vLLM/Groq...)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=

# ---- Local development only (backend/.env) ----
# ENV=development
# DEV_LOGIN_ENABLED=true
# COOKIE_SECURE=true
# PUBLIC_URL=http://localhost:3000
